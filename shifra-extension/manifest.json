{
  "manifest_version": 3,
  "name": "Shifra Tab Controller",
  "version": "1.0",
  "description": "Allows Shifra Virtual Assistant to open and close browser tabs",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon.png",
      "48":  "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
